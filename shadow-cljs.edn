{:nrepl {:port 8777}

 :deps {:aliases [:dev]}

 :dev-http
 {4200 "public"}

 :builds
 {:app {:target :browser

        :output-dir "public/js"
        :asset-path "/js"
        :module-loader true
        :modules
        {:main {:init-fn otp.core/init!}

         :landing-view {:entries [otp.pages.landing.page]
                        :depends-on #{:main}}

         :video-background {:entries [otp.ui.video-background]
                            :depends-on #{:main}}

         :budget-view {:entries [otp.pages.budget.page]
                       :depends-on #{:main}}

         :mockup-view {:entries [otp.pages.mockup.page]
                       :depends-on #{:main}}

         :venue-view {:entries [otp.pages.venue.page]
                      :depends-on #{:main}}

         :artist-view {:entries [otp.pages.artist.page]
                       :depends-on #{:main}}

         :blog-view {:entries [otp.pages.blog.page]
                     :depends-on #{:main}}

         :press-view {:entries [otp.pages.press.page]
                      :depends-on #{:main}}}
        :build-hooks [(git-hash/hook)]
        :devtools {:reload-strategy :full
                   :repl-pprint true
                   :preloads [otp.dev user]}
        :dev {:js-options {:output-feature-set :es-unsupported
                           :language-in :unsupported}
              :compiler-options {:output-feature-set :es8}}}

  :release {:target :browser
            :output-dir "release/js"
            :asset-path "/js"
            :module-loader true
            :modules
            {:main {:init-fn otp.core/init!}

             :landing-view {:entries [otp.pages.landing.page]
                            :depends-on #{:main}}

             :video-background {:entries [otp.ui.video-background]
                                :depends-on #{:main}}

             :budget-view {:entries [otp.pages.budget.page]
                           :depends-on #{:main}}


             :mockup-view {:entries [otp.pages.mockup.page]
                           :depends-on #{:main}}

             :venue-view {:entries [otp.pages.venue.page]
                          :depends-on #{:main}}

             :artist-view {:entries [otp.pages.artist.page]
                           :depends-on #{:main}}

             :blog-view {:entries [otp.pages.blog.page]
                         :depends-on #{:main}}

             :press-view {:entries [otp.pages.press.page]
                          :depends-on #{:main}}}
            :build-hooks [(git-hash/hook)]
            :js-options {:output-feature-set :es-unsupported
                         :language-in :unsupported}
            :compiler-options {:output-feature-set :es8
                               :infer-externs true
                               :externs ["externs/three.ext.js"]
                               :optimizations :advanced
                               :pretty-print true
                               :pseudo-names true}}}}
